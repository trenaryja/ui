{
	"name": "@trenaryja/ui",
	"version": "0.0.1-35",
	"description": "",
	"author": "Justin Trenary",
	"license": "MIT",
	"type": "module",
	"homepage": "https://ui.trenary.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/trenaryja/ui.git"
	},
	"scripts": {
		"dev": "concurrently \"bun run build --watch\" \"bun run demo\"",
		"fix": "prettier -w . && eslint --fix .",
		"check": "tsc && prettier -c . && eslint .",
		"test": "concurrently -g --timings \"bun run lint\" \"bun run tsc\" \"bun run build && bun run test:build\"",
		"test:build": "bun test tests/build",
		"demo": "vite",
		"lint": "eslint .",
		"format": "prettier -w .",
		"tsc": "tsc",
		"build": "tsup",
		"build:use-client": "bun scripts/build-use-client.ts",
		"build:css": "bun scripts/build-css.ts",
		"build:nf": "bun scripts/build-nf.ts",
		"build:demo": "vite build",
		"postbuild": "bun run build:use-client && bun run build:css && bun run build:nf && bun run build:demo",
		"get-latest": "bun update --latest -i",
		"release": "bun run build && release-it --"
	},
	"types": "./dist/index.d.ts",
	"browser": "./dist/css/browser.css",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./css": "./dist/css/index.css",
		"./prose": "./dist/css/prose.css",
		"./browser": "./dist/css/browser.css",
		"./utils": {
			"import": "./dist/utils/index.js",
			"types": "./dist/utils/index.d.ts"
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css"
	],
	"devDependencies": {
		"@faker-js/faker": "^10.4.0",
		"@fullstacksjs/eslint-config": "^14.3.0",
		"@rolldown/plugin-babel": "^0.2.3",
		"@tailwindcss/cli": "4.3.0",
		"@tailwindcss/postcss": "4.3.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "4.3.0",
		"@types/bun": "^1.3.14",
		"@types/d3-geo": "^3.1.0",
		"@types/node": "^25.8.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@types/supercluster": "^7.1.3",
		"@types/topojson-client": "^3.1.5",
		"@types/topojson-specification": "^1.0.5",
		"@vitejs/plugin-react": "^6.0.2",
		"babel-plugin-react-compiler": "^1.0.0",
		"concurrently": "^9.2.1",
		"daisyui": "^5.5.19",
		"eslint": "^10.4.0",
		"nuqs": "^2.8.9",
		"prettier": "^3.8.3",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"react-markdown": "^10.1.0",
		"rehype-raw": "^7.0.0",
		"release-it": "^20.0.1",
		"tailwindcss": "4.3.0",
		"topojson-server": "^3.0.1",
		"topojson-simplify": "^3.0.3",
		"tsup": "^8.5.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.13"
	},
	"dependencies": {
		"@colordx/core": "^5.4.3",
		"@floating-ui/react": "^0.27.19",
		"@mantine/hooks": "^9.2.1",
		"@types/d3-selection": "^3.0.11",
		"@types/d3-transition": "^3.0.9",
		"@types/d3-zoom": "^3.0.8",
		"clsx": "^2.1.1",
		"d3-geo": "^3.1.1",
		"d3-geo-projection": "^4.0.0",
		"d3-selection": "^3.0.0",
		"d3-transition": "^3.0.1",
		"d3-zoom": "^3.0.0",
		"date-fns": "^4.1.0",
		"react-icons": "^5.6.0",
		"recharts": "^3.8.1",
		"remeda": "^2.34.1",
		"sonner": "^2.0.7",
		"supercluster": "^8.0.1",
		"tailwind-merge": "^3.6.0",
		"topojson-client": "^3.1.0",
		"type-fest": "^5.6.0"
	},
	"peerDependencies": {
		"daisyui": ">=5",
		"react": ">=19.2.6",
		"react-dom": ">=19.2.6",
		"tailwindcss": ">=4.2.4"
	},
	"postcss": {
		"plugins": {
			"@tailwindcss/postcss": {}
		}
	},
	"prettier": {
		"semi": false,
		"singleQuote": true,
		"printWidth": 120,
		"jsxSingleQuote": true,
		"useTabs": true
	},
	"release-it": {
		"git": {
			"commitMessage": "chore(release): v${version} [skip ci]"
		},
		"github": {
			"release": true
		},
		"npm": {
			"publish": false
		}
	},
	"tsup": {
		"clean": true,
		"dts": true,
		"entry": [
			"src/index.ts",
			"src/utils/index.ts"
		],
		"format": "esm",
		"treeshake": true,
		"external": [
			"react",
			"react-dom",
			"react/jsx-runtime"
		]
	},
	"patchedDependencies": {
		"tsup@8.5.1": "patches/tsup@8.5.1.patch"
	}
}
